# BCTN backend configuration (copy to `.env` for local dev)
#
# Notes:
# - The backend loads `.env` automatically at startup (via dotenv).
# - You can still override everything via CLI flags.
# - Logging is configured via `RUST_LOG` (used by `tracing-subscriber`).

# Bind address/port:
# Hardcoded in the backend to `0.0.0.0:2286` (override via docker-compose if needed).

# App (user/swipes) SQLite DB
BCTN_APP_DB=data/bctn_app.sqlite

# Names DB (read-only; built by `bctn-ingest`)
BCTN_NAMES_DB=data/bctn.sqlite

# Directory of static assets to serve (PWA build output)
BCTN_STATIC_DIR=web/build

# Set to `true` when running behind HTTPS (Secure cookies).
# For local HTTP development, keep this `false`.
BCTN_COOKIE_SECURE=false

# Optional: lock the app to a single public hostname (defense-in-depth).
# When set, requests with other Host values are rejected (and CSRF checks validate Origin against this host).
#BCTN_PUBLIC_HOST=bctn.example.com

# Trust reverse-proxy forwarded host headers (`X-Forwarded-Host`) for host/origin checks.
# Enable only when all traffic comes from a trusted proxy that strips untrusted forwarded headers.
#BCTN_TRUST_PROXY_HEADERS=false
# Optional shared secret for trusted proxy header forwarding.
# When set, forwarded host headers are honored only if `X-BCTN-Proxy-Secret` matches this value.
# Required when `BCTN_TRUST_PROXY_HEADERS=true`.
#BCTN_PROXY_HEADER_SECRET=replace-with-random-secret

# One-time admin bootstrap (optional).
# If set (either via env or flags), the server creates the first admin user ONLY if the DB has 0 users, then exits.
#BCTN_BOOTSTRAP_ADMIN_USERNAME=admin
#BCTN_BOOTSTRAP_ADMIN_PASSWORD=password123

# Logging
#
# `RUST_LOG` controls how much the app logs.
# - `info`  : normal operational messages (startup, important actions)
# - `debug` : detailed messages useful for troubleshooting (can be noisy)
# - `warn`  : something went wrong, but the app can keep running
# - `error` : something went wrong and needs attention
#
# Recommended presets:
# - Normal (recommended): show important messages and slow SQL warnings
#   RUST_LOG=info,tower_http=info,sqlx=warn
# - Quiet: reduce SQL noise once performance is stable
#   RUST_LOG=info,tower_http=info,sqlx=error
# - Troubleshooting: add debug logs for app routes (can be very noisy)
#   RUST_LOG=debug,tower_http=info,sqlx=warn
RUST_LOG=info,tower_http=info,sqlx=warn
